# Copy this file to .env at the repo root and fill in real values for local development.

YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret
YAHOO_REDIRECT_URI=https://localhost:8000/auth/yahoo/callback
TOKEN_ENCRYPTION_KEY=your-token-encryption-key
SESSION_SECRET=your-session-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/postgres
FRONTEND_ORIGIN=http://localhost:3000
DEV_AUTH_ENABLED=false
