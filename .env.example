# Copy this file to .env at the repo root and fill in real values for local development.

YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret
YAHOO_REDIRECT_URI=https://localhost:8000/auth/yahoo/callback
TOKEN_ENCRYPTION_KEY=your-token-encryption-key
SESSION_SECRET=your-session-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/postgres
FRONTEND_ORIGIN=http://localhost:3000
DEV_AUTH_ENABLED=false

# Claude advisor (optional). Leave ANTHROPIC_API_KEY unset and every feature
# returns its deterministic engine result plus a note saying written
# explanations are off -- that is a supported mode, not a degraded one, and it
# is what the test suite and CI run on. Set it to add model-written reasoning.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
