# Base URL of the FastAPI backend that /api/* and /auth/* are rewritten to.
# Defaults to http://localhost:8000 in next.config.ts if unset.
#
# IMPORTANT: next.config.ts rewrites are serialized into the routes manifest at
# `next build` time. Setting BACKEND_URL only at runtime (e.g. only in the
# `next start` environment, or injected by a container/PaaS after the image is
# built) has NO EFFECT — the build-time value is baked in and the runtime value
# is silently ignored. In production, BACKEND_URL MUST be set in the
# environment that runs `next build`, not just the one that runs `next start`.
BACKEND_URL=http://localhost:8000
